{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "dateStart": {
      "type": "date"
    },
    "dateEnd": {
      "type": "date"
    },
    "enrollmentStart": {
      "type": "date"
    },
    "enrollmentEnd": {
      "type": "date"
    },
    "clientContact": {
      "type": "string"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "mappedBy": "projects"
    },
    "employerOwner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::student.student"
    },
    "teams": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team.team",
      "mappedBy": "project"
    },
    "requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::request.request",
      "mappedBy": "project"
    },
    "related": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "curator": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "developerRequirements": {
      "type": "component",
      "repeatable": true,
      "component": "developer-requirement.developer-requirement"
    },
    "teamLimit": {
      "type": "integer"
    },
    "descriptionFiles": {
      "type": "component",
      "repeatable": true,
      "component": "named-file.named-file"
    },
    "resultFiles": {
      "type": "component",
      "repeatable": true,
      "component": "named-file.named-file"
    },
    "projectLink": {
      "displayName": "Project Link",
      "type": "component",
      "repeatable": true,
      "component": "project-link.project-link"
    },
    "slug": {
      "type": "uid"
    },
    "documents": {
      "type": "component",
      "repeatable": true,
      "component": "project-document.project-document"
    },
    "providers": {
      "type": "dynamiczone",
      "components": [
        "github-data.github-data"
      ]
    },
    "projectRequirements": {
      "displayName": "Project Requirements",
      "type": "component",
      "repeatable": true,
      "component": "developer-requirement.project-requirements"
    }
  }
}
